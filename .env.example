# ===== 数据库（连你本地 MySQL，默认值来自 application.yml）=====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=qiming

# uploads 目录绝对路径（默认指向上一级的 qiming-server/uploads）
# UPLOADS_DIR=C:/Users/asus-pc/Desktop/启明/qiming-server/uploads

# 说明：当前采用「不依赖 R2」方案 —— 媒体直接复制进 public/media/，
# 随前端构建一起托管到 Cloudflare Pages，无需任何云存储配置。
# 若以后想用 R2 分离大文件，再在此处加 R2_* 配置并改脚本。
